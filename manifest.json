{
  "manifest_version": 3,
  "name": "Printer Friendly Gmail",
  "version": "1.0.0",
  "description": "Hides the Gmail header, subject line, and sender details when printing an email.",
  "homepage_url": "https://github.com/travisty-/printer-friendly-gmail",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "css": ["content.css"],
      "matches": [
        "https://mail.google.com/mail/*?view=pt*",
        "https://mail.google.com/mail/*&view=pt*"
      ]
    }
  ]
}
